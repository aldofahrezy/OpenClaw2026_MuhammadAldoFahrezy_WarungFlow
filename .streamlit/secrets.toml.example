# Copy to Streamlit Cloud → App settings → Secrets
# https://docs.streamlit.io/streamlit-community-cloud/deploy-your-app/deploy
#
# Payment mode: select Mock or DOKU Sandbox in the app (Simulasi page), not here.

WARUNGFLOW_ENV = "production"
LLM_MODE = "mock"
WHATSAPP_MODE = "mock"
PUBLIC_BASE_URL = "https://your-app-name.streamlit.app"

# Optional — only if demoing DOKU Sandbox on cloud
# DOKU_CLIENT_ID = ""
# DOKU_SECRET_KEY = ""
# DOKU_SANDBOX_BASE_URL = "https://api-sandbox.doku.com"
