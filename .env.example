# =========================
# WarungFlow Runtime
# =========================
WARUNGFLOW_ENV=local
# Pembayaran dipilih di dashboard → Simulasi → Mode pembayaran (mock | doku_sandbox).
# Muat kredensial DOKU di bawah; UI yang menentukan provider aktif.
LLM_MODE=mock

# =========================
# Optional LLM Provider (Groq recommended for live mode)
# Set LLM_MODE=live and GROQ_API_KEY to enable AI-refined reminders.
# =========================
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=

# =========================
# DOKU Sandbox Credentials
# Required only for DOKU Sandbox Mode.
# Get these from DOKU Dashboard / Sandbox API Keys.
# =========================
DOKU_ENV=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_SANDBOX_BASE_URL=

# =========================
# Optional DOKU Key Pair / SNAP-style Integration
# Only needed if the DOKU integration path requires public/private key signing.
# Do not commit real key material.
# =========================
DOKU_PUBLIC_KEY=
MERCHANT_PUBLIC_KEY=
MERCHANT_PRIVATE_KEY_PATH=

# =========================
# Optional Webhook / Callback Config
# These are mostly config values, but webhook secrets should be treated as secret.
# =========================
DOKU_WEBHOOK_SECRET=
DOKU_NOTIFICATION_URL=
DOKU_CALLBACK_URL=
DOKU_SUCCESS_URL=
DOKU_FAILED_URL=

# =========================
# Optional MCP Server
# Only needed if using a DOKU MCP server or custom payment MCP bridge.
# =========================
DOKU_MCP_SERVER_URL=
DOKU_MCP_AUTH_TOKEN=

# =========================
# WhatsApp Bot
# =========================
WHATSAPP_MODE=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_BASE_URL=
WHATSAPP_API_VERSION=v21.0
# Public URL for mock payment links in WhatsApp bot replies.
# Production (Streamlit only): use your live app URL — mock pay opens ?mock_pay=ORD-BOT-xxx
PUBLIC_BASE_URL=http://localhost:8501
WARUNGFLOW_LIVE_URL=http://43.157.208.68:8501

# Bot server (optional — only if running uvicorn bot_server on :8000)
BOT_SERVER_URL=http://localhost:8000
RUNTIME_EVENT_STORE=runtime/events.jsonl
